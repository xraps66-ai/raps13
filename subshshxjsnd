function initAuthUI(){
  ensureAdmin();
  var sess=getSession();
  if(sess&&sess.user){ showApp(sess.user); return true; }

  document.querySelectorAll(".auth-tab").forEach(function(tab){
    tab.addEventListener("click", function(){
      document.querySelectorAll(".auth-tab").forEach(function(t){ t.classList.remove("active"); });
      tab.classList.add("active");
      var name=tab.getAttribute("data-tab");
      document.querySelectorAll(".auth-form").forEach(function(f){ f.classList.remove("active"); });
      var form=document.getElementById(name==="login"?"formLogin":"formRegister");
      if(form) form.classList.add("active");
    });
  });

  document.querySelectorAll(".auth-eye").forEach(function(btn){
    btn.addEventListener("click", function(){
      var inp=document.getElementById(btn.getAttribute("data-for"));
      if(!inp) return;
      var on=inp.type==="password";
      inp.type=on?"text":"password";
      btn.innerHTML=on?'<i class="fas fa-eye-slash"></i>':'<i class="fas fa-eye"></i>';
    });
  });

  var formLogin=document.getElementById("formLogin");
  if(formLogin) formLogin.addEventListener("submit", function(e){
    e.preventDefault();
    e.stopPropagation();
    var user=(document.getElementById("loginUser").value||"").trim().toLowerCase();
    var pass=document.getElementById("loginPass").value||"";
    var msg=document.getElementById("loginMsg");
    if(!user||!pass){ msg.textContent="Isi username & password"; msg.className="auth-msg"; return false; }
    var users=loadUsers();
    var ok=(user===ADMIN.user&&pass===ADMIN.pass)||(users[user]&&users[user].pass===simpleHash(pass));
    if(!ok){ msg.textContent="Username atau password salah"; msg.className="auth-msg"; return false; }
    if(!users[user]){ users[user]={pass:simpleHash(pass),created:Date.now()}; saveUsers(users); }
    setSession(user);
    msg.textContent="Berhasil masuk"; msg.className="auth-msg ok";
    setTimeout(function(){ showApp(user); }, 200);
    return false;
  });

  var formRegister=document.getElementById("formRegister");
  if(formRegister) formRegister.addEventListener("submit", function(e){
    e.preventDefault();
    e.stopPropagation();
    var user=(document.getElementById("regUser").value||"").trim().toLowerCase();
    var pass=document.getElementById("regPass").value||"";
    var pass2=document.getElementById("regPass2").value||"";
    var msg=document.getElementById("regMsg");
    if(user.length<3){ msg.textContent="Username minimal 3 karakter"; msg.className="auth-msg"; return false; }
    if(!/^[a-z0-9_]+$/i.test(user)){ msg.textContent="Username hanya huruf, angka, underscore"; msg.className="auth-msg"; return false; }
    if(pass.length<4){ msg.textContent="Password minimal 4 karakter"; msg.className="auth-msg"; return false; }
    if(pass!==pass2){ msg.textContent="Password tidak sama"; msg.className="auth-msg"; return false; }
    var users=loadUsers();
    if(users[user]){ msg.textContent="Username sudah dipakai"; msg.className="auth-msg"; return false; }
    users[user]={pass:simpleHash(pass),created:Date.now()};
    saveUsers(users);
    setSession(user);
    msg.textContent="Akun berhasil dibuat"; msg.className="auth-msg ok";
    setTimeout(function(){ showApp(user); }, 200);
    return false;
  });

  var btnOut=document.getElementById("btnLogout");
  if(btnOut) btnOut.addEventListener("click", function(){
    clearSession();
    showGate();
    try{ location.reload(); }catch(e){}
  });
  return false;
}

