function initTopNav(){
  const menu=document.getElementById("topMenu");
  const btn=document.getElementById("hmbBtn");
  if(btn&&menu){
    btn.addEventListener("click",e=>{e.stopPropagation();menu.classList.toggle("is-open");btn.setAttribute("aria-expanded",menu.classList.contains("is-open")?"true":"false")});
    document.addEventListener("click",e=>{if(!menu.contains(e.target))menu.classList.remove("is-open")});
  }
  const openModal=id=>{const m=document.getElementById(id);if(m)m.classList.add("open")};
  const closeModals=()=>document.querySelectorAll(".rapz-modal.open").forEach(m=>m.classList.remove("open"));
  document.querySelectorAll("[data-close-modal]").forEach(b=>b.addEventListener("click",closeModals));
  document.querySelectorAll(".rapz-modal").forEach(m=>m.addEventListener("click",e=>{if(e.target===m)closeModals()}));
  const about=document.getElementById("menuAbout");
  const report=document.getElementById("menuReport");
  const wa=document.getElementById("menuWA");
  if(about)about.addEventListener("click",()=>{menu.classList.remove("is-open");openModal("modalAbout")});
  if(report)report.addEventListener("click",()=>{menu.classList.remove("is-open");openModal("modalReport")});
  if(wa)wa.addEventListener("click",()=>{menu.classList.remove("is-open");window.open("https://whatsapp.com/channel/0029Vb7yYjE8PgsKrQ5ghQ3s","_blank","noopener,noreferrer")});
  const send=document.getElementById("reportSend");
  if(send)send.addEventListener("click",()=>{
    const t=(document.getElementById("reportMsg").value||"").trim()||"Halo, saya ingin report/saran untuk Rapz Tools";
    window.open("https://wa.me/?text="+encodeURIComponent(t),"_blank","noopener,noreferrer");
  });

  // Music player (video streams used as audio like original)
  const tracks=[
    "https://c.termai.cc/v173/pebJ.mp4",
    "https://c.termai.cc/v136/Httas.mp4",
    "https://c.termai.cc/v149/AptQy.mp4"
  ];
  let idx=0, playing=false;
  const audio=new Audio();
  audio.preload="none";
  audio.crossOrigin="anonymous";
  const vmp=document.getElementById("vMP");
  const btnPlay=document.getElementById("mpPlay");
  const btnMute=document.getElementById("mpMute");
  const btnNext=document.getElementById("mpNext");
  function load(i){idx=(i+tracks.length)%tracks.length;audio.src=tracks[idx];}
  function setPlayUI(on){
    playing=on;
    if(vmp)vmp.classList.toggle("on",on&&!audio.muted);
    if(btnPlay)btnPlay.innerHTML=on?'<i class="fas fa-pause"></i>':'<i class="fas fa-play"></i>';
  }
  async function play(){
    try{
      if(!audio.src)load(idx);
      await audio.play();
      setPlayUI(true);
    }catch(e){toast("Tap lagi untuk play musik");setPlayUI(false)}
  }
  function pause(){audio.pause();setPlayUI(false)}
  if(btnPlay)btnPlay.addEventListener("click",()=>{playing?pause():play()});
  if(btnMute)btnMute.addEventListener("click",()=>{
    audio.muted=!audio.muted;
    if(vmp){vmp.classList.toggle("mu",audio.muted);if(!audio.muted&&playing)vmp.classList.add("on");else if(audio.muted)vmp.classList.remove("on")}
    btnMute.innerHTML=audio.muted?'<i class="fas fa-volume-xmark"></i>':'<i class="fas fa-volume-high"></i>';
  });
  if(btnNext)btnNext.addEventListener("click",async()=>{
    const was=playing;pause();load(idx+1);if(was)await play();
  });
  audio.addEventListener("ended",()=>{load(idx+1);play()});
  load(0);
}


const AUTH_KEY="rapz_tools_users_v1";
