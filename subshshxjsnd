<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
<meta name="theme-color" content="#0a0015"/>
<title>Project Rapzwy</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800&family=Poppins:wght@300;400;500;600;700&display=swap"/>
<style>
:root{--bg:#0a0015;--card:rgba(20,8,40,.88);--border:rgba(168,85,247,.25);--purple:#a855f7;--purple-d:#7c3aed;--text:#e9d5ff;--muted:#8b7ab8;--ok:#4ade80;--err:#f87171}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{min-height:100%;background:var(--bg);color:var(--text);font-family:Poppins,sans-serif}
body{overflow-x:hidden}
.bg{position:fixed;inset:0;z-index:0;pointer-events:none;background:radial-gradient(ellipse at 20% 30%,rgba(124,58,237,.18),transparent 55%),radial-gradient(ellipse at 80% 70%,rgba(168,85,247,.12),transparent 50%),var(--bg)}
.bg::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(124,58,237,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(124,58,237,.06) 1px,transparent 1px);background-size:48px 48px}
#splash{position:fixed;inset:0;z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#030008;transition:opacity .6s,visibility .6s}
#splash.hide{opacity:0;visibility:hidden;pointer-events:none}
.splash-title{font-family:Orbitron,sans-serif;font-weight:800;font-size:clamp(1.6rem,6vw,2.4rem);background:linear-gradient(90deg,#e9d5ff,#c084fc,#a855f7);-webkit-background-clip:text;background-clip:text;color:transparent}
.splash-sub{color:var(--muted);font-size:.85rem;margin-top:8px}
.splash-bar{width:min(220px,60vw);height:3px;margin-top:28px;background:rgba(168,85,247,.15);border-radius:99px;overflow:hidden}
.splash-bar>i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--purple-d),var(--purple));animation:loadBar 1.8s ease forwards}
@keyframes loadBar{to{width:100%}}
.wrap{position:relative;z-index:1;max-width:1100px;margin:0 auto;padding:20px 16px 80px}
header.hero{text-align:center;padding:28px 12px 18px}
header.hero h1{font-family:Orbitron,sans-serif;font-weight:800;font-size:clamp(1.5rem,5vw,2.1rem);background:linear-gradient(90deg,#e9d5ff,#c084fc,#a855f7);-webkit-background-clip:text;background-clip:text;color:transparent}
header.hero p{color:var(--muted);font-size:.9rem;margin-top:6px}
.badge-row{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:14px}
.pill{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:999px;font-size:11px;font-weight:600;border:1px solid var(--border);background:rgba(168,85,247,.08);color:#c4b5fd}
.pill.gold{border-color:rgba(250,204,21,.4);background:linear-gradient(135deg,rgba(250,204,21,.12),rgba(168,85,247,.15));color:#facc15}
.search-box{position:relative;max-width:480px;margin:18px auto 14px}
.search-box input{width:100%;padding:12px 14px 12px 42px;border-radius:14px;border:1px solid var(--border);background:rgba(15,5,30,.8);color:var(--text);font-family:inherit;font-size:14px;outline:none}
.search-box input:focus{border-color:rgba(168,85,247,.55);box-shadow:0 0 0 3px rgba(168,85,247,.12)}
.search-box i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:14px}
.tabs{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:22px}
.tab{border:1px solid var(--border);background:rgba(168,85,247,.06);color:var(--muted);padding:8px 14px;border-radius:999px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:6px;transition:.2s}
.tab:hover{color:var(--text);border-color:rgba(168,85,247,.4)}
.tab.active{background:linear-gradient(135deg,var(--purple-d),var(--purple));color:#fff;border-color:transparent;box-shadow:0 6px 20px rgba(124,58,237,.35)}
.section-title{font-size:13px;font-weight:600;color:var(--muted);margin:8px 4px 12px;display:flex;align-items:center;gap:8px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
.card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:16px 14px 14px;cursor:pointer;transition:transform .18s,border-color .18s,box-shadow .18s;min-height:128px;display:flex;flex-direction:column}
.card:hover,.card:active{transform:translateY(-3px);border-color:rgba(168,85,247,.5);box-shadow:0 12px 28px rgba(80,20,160,.25)}
.card .icon{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(145deg,rgba(124,58,237,.25),rgba(168,85,247,.1));color:#c084fc;font-size:16px;margin-bottom:10px}
.card h3{font-size:13px;font-weight:700;margin-bottom:4px;line-height:1.3}
.card p{font-size:11px;color:var(--muted);line-height:1.4;flex:1}
.card .tag{align-self:flex-start;margin-top:8px;font-size:9px;font-weight:700;letter-spacing:.04em;padding:2px 8px;border-radius:6px;background:rgba(168,85,247,.15);color:#c4b5fd}
#viewer{position:fixed;inset:0;z-index:1000;display:none;flex-direction:column;background:rgba(5,0,12,.72);backdrop-filter:blur(8px)}
#viewer.open{display:flex}
.viewer-panel{margin:auto;width:min(560px,100%);max-height:min(92vh,860px);background:#12061f;border:1px solid var(--border);border-radius:20px 20px 0 0;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 -10px 50px rgba(0,0,0,.5)}
@media(min-width:640px){.viewer-panel{border-radius:20px}}
.viewer-head{display:flex;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid var(--border);background:rgba(168,85,247,.06)}
.viewer-head .back{width:36px;height:36px;border-radius:10px;border:1px solid var(--border);background:rgba(168,85,247,.1);color:var(--text);cursor:pointer;display:grid;place-items:center}
.viewer-head h2{font-size:15px;font-weight:700;flex:1}
.viewer-body{padding:16px;overflow-y:auto;flex:1}
.field{margin-bottom:12px}
.field label{display:block;font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:6px}
.field input,.field textarea,.field select{width:100%;padding:11px 12px;border-radius:12px;border:1px solid var(--border);background:rgba(168,85,247,.06);color:var(--text);font-family:inherit;font-size:14px;outline:none;resize:vertical}
.field textarea{min-height:100px}
.field input:focus,.field textarea:focus,.field select:focus{border-color:rgba(168,85,247,.55);box-shadow:0 0 0 3px rgba(168,85,247,.12)}
.row{display:flex;gap:8px;flex-wrap:wrap}.row>*{flex:1;min-width:110px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:11px 16px;border:0;border-radius:12px;font-family:inherit;font-weight:700;font-size:13px;cursor:pointer;background:linear-gradient(135deg,var(--purple-d),var(--purple));color:#fff;box-shadow:0 6px 18px rgba(124,58,237,.35);transition:transform .15s}
.btn:active{transform:scale(.98)}.btn:disabled{opacity:.55;cursor:not-allowed}
.btn.ghost{background:rgba(168,85,247,.1);border:1px solid var(--border);color:#c4b5fd;box-shadow:none}
.btn-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}.btn-row .btn{flex:1;min-width:110px}
.out{margin-top:12px;padding:12px;border-radius:12px;background:rgba(0,0,0,.25);border:1px solid var(--border);font-size:13px;word-break:break-word;white-space:pre-wrap;min-height:44px;color:#ddd6fe}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:10px}
.stat{padding:10px;border-radius:12px;border:1px solid var(--border);background:rgba(168,85,247,.06);text-align:center}
.stat b{display:block;font-size:18px;color:#c084fc}.stat span{font-size:11px;color:var(--muted)}
.preview-box{margin-top:12px;border-radius:14px;overflow:hidden;border:1px solid var(--border);background:rgba(0,0,0,.25)}
.preview-box img,.preview-box video{display:block;width:100%;max-height:280px;object-fit:contain;background:#000}
.preview-meta{padding:10px 12px;font-size:12px;color:var(--muted)}.preview-meta b{color:#c4b5fd}
.dl-links{display:flex;flex-direction:column;gap:8px;margin-top:10px}
.dl-links a{display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:12px;background:rgba(168,85,247,.1);border:1px solid var(--border);color:#e9d5ff;text-decoration:none;font-size:13px;font-weight:600}
.dl-links a:hover{border-color:rgba(168,85,247,.5)}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);background:#1a0a2e;border:1px solid var(--border);color:var(--text);padding:10px 18px;border-radius:12px;font-size:13px;font-weight:600;opacity:0;pointer-events:none;transition:.25s;z-index:2000;box-shadow:0 10px 30px rgba(0,0,0,.4)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
footer{text-align:center;padding:28px 12px 10px;color:var(--muted);font-size:12px}footer b{color:#c4b5fd}
.empty{text-align:center;padding:40px 16px;color:var(--muted);font-size:14px}
.hint{font-size:12px;color:var(--muted);margin-bottom:10px;line-height:1.45}
.loading{text-align:center;padding:20px;color:#c4b5fd;font-size:13px}

/* ===== LOGIN / DAFTAR ===== */
#authGate{position:fixed;inset:0;z-index:10000;display:flex;align-items:center;justify-content:center;padding:16px;
  background:radial-gradient(ellipse at 30% 20%,rgba(124,58,237,.22),transparent 50%),radial-gradient(ellipse at 70% 80%,rgba(168,85,247,.14),transparent 45%),#05000e;
  overflow:auto}
#authGate.hidden{display:none}
.auth-orbs{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.auth-orbs span{position:absolute;border-radius:50%;filter:blur(40px);opacity:.45;animation:orbFloat 12s ease-in-out infinite}
.auth-orbs span:nth-child(1){width:220px;height:220px;background:#7c3aed;top:10%;left:10%;animation-delay:0s}
.auth-orbs span:nth-child(2){width:180px;height:180px;background:#a855f7;bottom:15%;right:12%;animation-delay:2s}
.auth-orbs span:nth-child(3){width:140px;height:140px;background:#6366f1;top:50%;left:50%;animation-delay:4s}
@keyframes orbFloat{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(20px,-18px) scale(1.08)}}
.auth-card{position:relative;width:min(400px,100%);background:rgba(18,6,32,.92);border:1px solid rgba(168,85,247,.3);
  border-radius:22px;padding:28px 22px 22px;box-shadow:0 20px 60px rgba(0,0,0,.55);backdrop-filter:blur(16px);
  animation:authIn .55s cubic-bezier(.22,1,.36,1)}
@keyframes authIn{from{opacity:0;transform:translateY(18px) scale(.96)}to{opacity:1;transform:none}}
.auth-logo{text-align:center;margin-bottom:18px}
.auth-logo .mark{width:52px;height:52px;margin:0 auto 10px;border-radius:16px;display:grid;place-items:center;
  background:linear-gradient(135deg,#7c3aed,#a855f7);font-size:22px;color:#fff;box-shadow:0 8px 24px rgba(124,58,237,.45)}
.auth-logo h1{font-family:Orbitron,sans-serif;font-size:1.25rem;font-weight:800;
  background:linear-gradient(90deg,#e9d5ff,#c084fc,#a855f7);-webkit-background-clip:text;background-clip:text;color:transparent}
.auth-logo p{color:var(--muted);font-size:12px;margin-top:4px}
.auth-tabs{display:flex;gap:6px;padding:4px;background:rgba(168,85,247,.08);border-radius:12px;margin-bottom:18px;border:1px solid var(--border)}
.auth-tab{flex:1;padding:10px;border:0;border-radius:10px;background:transparent;color:var(--muted);font-family:inherit;font-weight:700;font-size:13px;cursor:pointer;transition:.2s}
.auth-tab.active{background:linear-gradient(135deg,#7c3aed,#a855f7);color:#fff;box-shadow:0 4px 14px rgba(124,58,237,.35)}
.auth-form{display:none}.auth-form.active{display:block}
.auth-field{margin-bottom:12px;position:relative}
.auth-field label{display:block;font-size:11px;font-weight:600;color:var(--muted);margin-bottom:6px;text-transform:uppercase;letter-spacing:.04em}
.auth-field input{width:100%;padding:12px 40px 12px 12px;border-radius:12px;border:1px solid var(--border);
  background:rgba(168,85,247,.06);color:var(--text);font-family:inherit;font-size:14px;outline:none}
.auth-field input:focus{border-color:rgba(168,85,247,.55);box-shadow:0 0 0 3px rgba(168,85,247,.12)}
.auth-eye{position:absolute;right:10px;bottom:11px;background:none;border:0;color:var(--muted);cursor:pointer;font-size:14px;padding:4px}
.auth-msg{font-size:12px;min-height:18px;margin:4px 0 10px;color:var(--err)}
.auth-msg.ok{color:var(--ok)}
.auth-submit{width:100%;padding:13px;border:0;border-radius:12px;font-family:inherit;font-weight:700;font-size:14px;cursor:pointer;
  background:linear-gradient(135deg,#7c3aed,#a855f7);color:#fff;box-shadow:0 8px 22px rgba(124,58,237,.4)}
.auth-submit:active{transform:scale(.98)}
.auth-foot{text-align:center;margin-top:14px;font-size:11px;color:var(--muted)}
#appRoot{display:none}#appRoot.show{display:block}#appRoot.show .wrap{display:block}
.user-bar{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:12px}
.user-bar .uname{font-size:12px;color:#c4b5fd;font-weight:600}
.user-bar .logout{border:1px solid var(--border);background:rgba(168,85,247,.1);color:#c4b5fd;padding:5px 12px;border-radius:999px;
  font-size:11px;font-weight:700;cursor:pointer;font-family:inherit}
.user-bar .logout:hover{border-color:rgba(168,85,247,.5)}


/* ===== TOP NAV (Menu Informasi + Music + Hamburger) ===== */
.top-nav{
  position:sticky;top:0;z-index:50;width:100%;
  background:rgba(7,5,12,.88);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  border-bottom:1px solid rgba(255,255,255,.06);
}
.top-nav-inner{
  max-width:1100px;margin:0 auto;padding:10px 14px;
  display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:48px;
}
.top-nav-left{display:flex;align-items:center;gap:9px;min-width:0;flex:1}
.top-nav-mark{
  width:32px;height:32px;display:grid;place-items:center;flex:0 0 auto;
  border:1px solid rgba(255,255,255,.08);border-radius:9px;background:rgba(255,255,255,.035);color:#b9adc5;font-size:12px;
}
.top-nav-text{min-width:0;display:grid;gap:2px}
.top-nav-text b{color:#dcd5e3;font-size:11px;font-weight:800;letter-spacing:.02em}
.top-nav-text span{color:#6f6577;font-size:9px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.top-nav-right{display:flex;align-items:center;gap:8px;flex:0 0 auto}

/* mini player */
.vMP{display:flex;align-items:center;gap:3px;height:32px;padding:0 7px;border-radius:16px;
  border:1px solid rgba(168,85,247,.5);background:rgba(40,0,80,.45);backdrop-filter:blur(14px);flex-shrink:0}
.vMP .eq{display:flex;align-items:flex-end;gap:1.5px;height:12px}
.vMP .eq b{display:block;width:3px;border-radius:2px;background:linear-gradient(to top,#7c3aed,#e879f9)}
.vMP .eq b:nth-child(1){height:4px}.vMP .eq b:nth-child(2){height:11px}
.vMP .eq b:nth-child(3){height:7px}.vMP .eq b:nth-child(4){height:11px}.vMP .eq b:nth-child(5){height:4px}
@keyframes ve1{0%,100%{height:2px}50%{height:12px}}
@keyframes ve2{0%,100%{height:12px}50%{height:2px}}
@keyframes ve3{0%,100%{height:6px}33%{height:13px}66%{height:2px}}
.vMP.on .eq b:nth-child(1){animation:ve1 .6s ease-in-out infinite}
.vMP.on .eq b:nth-child(2){animation:ve2 .5s ease-in-out infinite .1s}
.vMP.on .eq b:nth-child(3){animation:ve3 .7s ease-in-out infinite}
.vMP.on .eq b:nth-child(4){animation:ve2 .55s ease-in-out infinite .15s}
.vMP.on .eq b:nth-child(5){animation:ve1 .65s ease-in-out infinite .05s}
.vMP.mu .eq b{background:rgba(255,255,255,.2)!important;animation:none!important;height:2px!important}
.vB{width:24px;height:24px;border:none;background:rgba(255,255,255,.07);color:#c084fc;border-radius:6px;
  cursor:pointer;display:grid;place-items:center;padding:0;flex-shrink:0;font-size:10px}
.vB:hover{background:rgba(168,85,247,.35);color:#fff}

/* hamburger */
.hmb{width:40px;height:40px;display:grid;place-items:center;padding:0;border:1px solid rgba(255,255,255,.1);
  border-radius:10px;background:rgba(255,255,255,.035);color:#b7adbf;cursor:pointer}
.hmb:hover,.top-menu.is-open .hmb{border-color:rgba(255,255,255,.18);background:rgba(255,255,255,.065);color:#f1edf4}
.hmb-lines{width:18px;height:12px;position:relative;display:block}
.hmb-lines span{position:absolute;left:0;width:100%;height:2px;border-radius:99px;background:currentColor;transition:.18s}
.hmb-lines span:nth-child(1){top:0}.hmb-lines span:nth-child(2){top:5px}.hmb-lines span:nth-child(3){top:10px}
.top-menu.is-open .hmb-lines span:nth-child(1){top:5px;transform:rotate(45deg)}
.top-menu.is-open .hmb-lines span:nth-child(2){opacity:0}
.top-menu.is-open .hmb-lines span:nth-child(3){top:5px;transform:rotate(-45deg)}
.top-menu{position:relative}
.menu-panel{
  position:absolute;right:0;top:calc(100% + 8px);width:min(300px,calc(100vw - 28px));
  background:rgba(18,8,32,.97);border:1px solid rgba(168,85,247,.28);border-radius:16px;
  padding:12px;box-shadow:0 16px 40px rgba(0,0,0,.5);display:none;z-index:60;
}
.top-menu.is-open .menu-panel{display:block;animation:authIn .25s ease}
.menu-panel-title{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;padding:4px 4px 10px;border-bottom:1px solid rgba(255,255,255,.06)}
.menu-panel-title b{font-size:12px;color:#e9d5ff}.menu-panel-title span{font-size:10px;color:var(--muted)}
.menu-status{font-size:9px;font-weight:700;color:#4ade80;display:flex;align-items:center;gap:4px}
.menu-status i{font-size:6px}
.menu-item{
  width:100%;display:flex;align-items:center;gap:10px;padding:10px;border:1px solid transparent;border-radius:12px;
  background:transparent;color:var(--text);cursor:pointer;text-align:left;font-family:inherit;margin-bottom:4px;transition:.15s;
}
.menu-item:hover{background:rgba(168,85,247,.1);border-color:rgba(168,85,247,.25)}
.menu-item-icon{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:rgba(168,85,247,.15);color:#c084fc;flex:0 0 auto}
.menu-item-copy{flex:1;min-width:0}
.menu-item-copy b{display:block;font-size:12px;font-weight:700}
.menu-item-copy span{display:block;font-size:10px;color:var(--muted);line-height:1.3;margin-top:2px}
.menu-item-arrow{color:var(--muted);font-size:11px}

/* simple modal for about/report */
.rapz-modal{position:fixed;inset:0;z-index:3000;display:none;align-items:center;justify-content:center;
  padding:16px;background:rgba(5,0,12,.75);backdrop-filter:blur(6px)}
.rapz-modal.open{display:flex}
.rapz-modal-card{width:min(400px,100%);background:#12061f;border:1px solid var(--border);border-radius:18px;padding:20px;max-height:85vh;overflow:auto}
.rapz-modal-card h3{font-size:16px;margin-bottom:8px}
.rapz-modal-card p{font-size:13px;color:var(--muted);line-height:1.5;margin-bottom:10px}
.rapz-modal-card .close-m{margin-top:12px}
@media(max-width:420px){
  .top-nav-text span{font-size:8px;max-width:42vw;overflow:hidden;text-overflow:ellipsis}
  .vMP .eq{display:none}
}




function initBannerVideo(){
  var video=document.getElementById("bannerVideo");
  if(!video) return;
  function play(){
    video.muted=true;video.defaultMuted=true;video.playsInline=true;video.volume=0;
    try{var p=video.play();if(p&&p.catch)p.catch(function(){})}catch(e){}
  }
  video.addEventListener("loadeddata",play);
  video.addEventListener("canplay",play);
  document.addEventListener("pointerdown",play,{once:true,passive:true});
  play();
  setTimeout(play,400);
  setTimeout(play,1200);
}

/* ===== STATUS BAR ===== */
.status-bar{max-width:1100px;margin:14px auto;padding:0 16px;position:relative;z-index:5}
.status-card{
  display:flex;align-items:center;gap:12px;flex-wrap:wrap;
  padding:14px 16px;border-radius:20px;
  background:#1a0b2e;
  border:1px solid rgba(168,85,247,.4);
  box-shadow:0 10px 32px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.04);
}
.status-avatar{
  width:48px;height:48px;border-radius:50%;flex:0 0 auto;
