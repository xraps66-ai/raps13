function getSession(){
  if(__memSession&&__memSession.user) return __memSession;
  try{
    var raw=localStorage.getItem(SESSION_KEY);
    if(raw){ __memSession=JSON.parse(raw); return __memSession; }
  }catch(e){}
  try{
    var raw2=sessionStorage.getItem(SESSION_KEY);
    if(raw2){ __memSession=JSON.parse(raw2); return __memSession; }
  }catch(e){}
  return null;
}
function setSession(user){
  __memSession={user:String(user),at:Date.now()};
  try{ localStorage.setItem(SESSION_KEY, JSON.stringify(__memSession)); }catch(e){}
  try{ sessionStorage.setItem(SESSION_KEY, JSON.stringify(__memSession)); }catch(e){}
}
function clearSession(){
