function simpleHash(s){
  s=String(s||"");
  var h=5381;
  for(var i=0;i<s.length;i++) h=((h<<5)+h)^s.charCodeAt(i);
  var hex=("00000000"+(h>>>0).toString(16)).slice(-8);
  try{ return hex+btoa(unescape(encodeURIComponent(s))).slice(0,16); }
  catch(e){ return hex+String(s.length)+hex; }
}
function loadUsers(){
  if(__memUsers) return __memUsers;
  try{
    var raw=localStorage.getItem(AUTH_KEY);
    __memUsers=raw?JSON.parse(raw):{};
  }catch(e){ __memUsers={}; }
  return __memUsers;
}
function saveUsers(u){
  __memUsers=u||{};
  try{ localStorage.setItem(AUTH_KEY, JSON.stringify(__memUsers)); }catch(e){}
}
