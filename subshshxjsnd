(function(){
"use strict";


/* ===== STATUS BAR ===== */
function detectDevice(){
  const ua=navigator.userAgent||"";
  if(/iPad|Tablet/i.test(ua)) return "Tablet";
  if(/Mobile|Android|iPhone|iPod/i.test(ua)) return "Android";
  if(/Macintosh/i.test(ua)) return "Mac";
  if(/Windows/i.test(ua)) return "Windows";
  if(/Linux/i.test(ua)) return "Linux";
  return "Desktop";
}
function detectBrowser(){
  const ua=navigator.userAgent||"";
  if(/Edg\//i.test(ua)) return "Edge";
  if(/OPR\/|Opera/i.test(ua)) return "Opera";
  if(/Chrome/i.test(ua) && !/Edg\//i.test(ua)) return "Chrome";
  if(/Safari/i.test(ua) && !/Chrome/i.test(ua)) return "Safari";
  if(/Firefox/i.test(ua)) return "Firefox";
  return "Browser";
}
function countryFlag(code){
  if(!code||code.length!==2) return "";
  const c=code.toUpperCase();
  return String.fromCodePoint(...[...c].map(ch=>127397+ch.charCodeAt(0)));
}
async function fillCountry(){
  const el=document.getElementById("stCountry");
  if(!el) return;
  try{
    const r=await fetch("https://ipapi.co/json/",{cache:"no-store"});
    if(!r.ok) throw new Error("fail");
    const d=await r.json();
    const flag=countryFlag(d.country_code||"");
    el.textContent=(flag?flag+" ":"")+(d.country_name||d.country||"Unknown");
  }catch{
    try{
      const r=await fetch("https://ip-api.com/json/?fields=status,country,countryCode",{cache:"no-store"});
      const d=await r.json();
      if(d.status==="success"){
        el.textContent=countryFlag(d.countryCode)+" "+d.country;
        return;
      }
    }catch{}
    el.textContent="🌍 Unknown";
  }
}
function fillBattery(){
  const pct=document.getElementById("batPct");
  const fill=document.getElementById("batFill");
  const ico=document.querySelector("#stBattery .bat-ico");
  const apply=(level,charging)=>{
    const p=Math.round(level*100);
    if(pct) pct.textContent=p+"%";
    if(fill) fill.style.width=p+"%";
    if(ico){
      if(charging) ico.className="fas fa-bolt bat-ico";
      else if(p>80) ico.className="fas fa-battery-full bat-ico";
      else if(p>50) ico.className="fas fa-battery-three-quarters bat-ico";
      else if(p>20) ico.className="fas fa-battery-half bat-ico";
      else ico.className="fas fa-battery-quarter bat-ico";
    }
  };
  if(navigator.getBattery){
    navigator.getBattery().then(b=>{
      apply(b.level,b.charging);
      b.addEventListener("levelchange",()=>apply(b.level,b.charging));
      b.addEventListener("chargingchange",()=>apply(b.level,b.charging));
    }).catch(()=>{if(pct)pct.textContent="—"});
  } else {
    if(pct) pct.textContent="—";
  }
}
function updateRoleUI(user){
  const role=document.getElementById("stRole");
  if(!role) return;
  const isAdmin=user && user.toLowerCase()==="rapzwy";
  if(isAdmin){
    role.className="role-pill vvip";
    role.innerHTML='<i class="fas fa-crown"></i> Role : VVIP';
  } else {
    role.className="role-pill";
    role.innerHTML='<i class="fas fa-user"></i> Role : member';
  }
}
function initStatusBar(){
  const stDevice=document.getElementById("stDevice");
  const stBrowser=document.getElementById("stBrowser");
  const stOnline=document.getElementById("stOnline");
  if(stDevice) stDevice.textContent=detectDevice();
  if(stBrowser) stBrowser.textContent=detectBrowser();
  const syncOnline=()=>{
    if(!stOnline) return;
    if(navigator.onLine){stOnline.textContent="Online";stOnline.classList.add("online")}
    else{stOnline.textContent="Offline";stOnline.classList.remove("online");stOnline.style.color="#f87171"}
  };
  syncOnline();
  window.addEventListener("online",syncOnline);
  window.addEventListener("offline",syncOnline);
  fillCountry();
  fillBattery();
  try{ const sess=typeof getSession==="function"?getSession():null; if(sess&&sess.user) updateRoleUI(sess.user);}catch(e){}
  const vvip=document.getElementById("vvipBtn");
  if(vvip) vvip.addEventListener("click",()=>{
    toast("Akses VVIP aktif di Rapz Tools — semua tools terbuka");
  });
}

